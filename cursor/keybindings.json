[
    {
        "key": "cmd+i",
        "command": "composerMode.agent"
    },
    {
        "key": "cmd+1",
        "command": "workbench.action.terminal.focus"
    },
    {
        "key": "cmd+1",
        "command": "workbench.action.focusActiveEditorGroup",
        "when": "terminalFocus"
    },
    {
        "key": "cmd+shift+c",
        "command": "-workbench.action.terminal.openNativeConsole"
    },
    {
        "key": "cmd+shift+c",
        "command": "copyRelativeFilePath"
    },
    {
        "key": "cmd+shift+f",
        "command": "workbench.action.tasks.runTask",
        "args": "SQLFluff Fix Current File",
        "when": "editorTextFocus && resourceExtname == .sql"
    },
    {
        "key": "cmd+shift+l",
        "command": "workbench.action.tasks.runTask",
        "args": "SQLFluff Lint Current File",
        "when": "editorTextFocus && resourceExtname == .sql"
    },
    {
        "key": "cmd+shift+b",
        "command": "workbench.action.terminal.sendSequence",
        "args": {
            "text": "black \"${file}\"\n"
        },
        "when": "editorTextFocus && resourceExtname == .py"
    },
    {
        "key": "cmd+s",
        "command": "workbench.action.files.save"
    },
    {
        "key": "cmd+shift+s",
        "command": "runCommands",
        "args": {
            "commands": [
                {
                    "command": "workbench.action.terminal.sendSequence",
                    "args": {
                        "text": "sqff \"${file}\"\nsqfl \"${file}\"\n"
                    }
                },
                {
                    "command": "workbench.action.files.save"
                }
            ]
        },
        "when": "editorTextFocus && resourceExtname == .sql"
    },
    {
        "key": "cmd+shift+s",
        "command": "runCommands",
        "args": {
            "commands": [
                {
                    "command": "workbench.action.terminal.sendSequence",
                    "args": {
                        "text": "black \"${file}\"\n"
                    }
                },
                {
                    "command": "workbench.action.files.save"
                }
            ]
        },
        "when": "editorTextFocus && resourceExtname == .py"
    },
    {
        "key": "ctrl+z",
        "command": "workbench.action.terminal.sendSequence",
        "args": {
            "text": "\u001f"
        }
    },
    {
        "key": "ctrl+shift+z",
        "command": "workbench.action.terminal.sendSequence",
        "args": {
            "text": "\u001f"
        }
    }
]
